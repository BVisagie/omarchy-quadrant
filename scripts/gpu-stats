#!/usr/bin/env bash
# gpu-stats — vendor-dispatching GPU helper for Quadrant.
#
#   gpu-stats list
#       Enumerate /sys/class/drm/cardN (not connectors) and report cards whose
#       vendor is known (AMD 0x1002, Intel 0x8086, NVIDIA 0x10de) AND that
#       have at least one readable metric. Output:
#       {"ok":true,"gpus":[{"card":"card0","vendor":"amd",
#                           "path":"/sys/class/drm/card0/device","boot":true,
#                           "slot":"0000:03:00.0","pciClass":"0x030000",
#                           "pciId":"1002:744c","driver":"amdgpu"}]}
#
#   gpu-stats sample amd|intel <device_path>
#       Emit readable sysfs fields as raw key=value lines inside the
#       envelope's payload string; Model.js validates and converts units.
#       Every file is treated as optional — amdgpu file availability varies
#       by kernel and ASIC.
#
#   gpu-stats sample nvidia <index>
#       Emit raw `nvidia-smi --query-gpu=... --format=csv,noheader,nounits`
#       output as the payload (row-capped, timeout-bounded). Runs only on
#       demand from the panel/segment, never from the 1 Hz stream.
#
# Everything is read-only. Failures emit {"ok":false,...} and exit non-zero.

# shellcheck disable=SC2016  # jq programs are single-quoted on purpose
set -euo pipefail

fail() {
  local msg=$1 bin=""
  if [[ -x /usr/bin/jq ]]; then bin=/usr/bin/jq
  else bin=$(command -v jq) || bin=""
  fi
  if [[ -n $bin ]]; then
    "$bin" -cn --arg e "$msg" '{ok:false, error:$e}'
  else
    printf '{"ok":false,"error":"helper unavailable"}\n'
  fi
  exit 1
}

# Prefer the distro path so a user-writable PATH entry cannot shadow the
# helper. Fall back to command -v for non-standard prefixes (Nix, etc.).
resolve_bin() {
  local n=$1
  [[ $n =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
  if [[ -x /usr/bin/$n ]]; then
    printf '%s\n' "/usr/bin/$n"
    return 0
  fi
  command -v "$n"
}

JQ=$(resolve_bin jq) || fail "jq not found"

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=gpu-intel-paths.sh
source "$SCRIPT_DIR/gpu-intel-paths.sh"

trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

uevent_field() {
  local path=$1 want=$2 line key val
  [[ -r $path ]] || return 1
  while IFS= read -r line; do
    key=${line%%=*}
    val=${line#*=}
    if [[ $key == "$want" ]]; then
      printf '%s' "$val"
      return 0
    fi
  done < "$path"
  return 1
}

vendor_name() {
  case $1 in
    0x1002) printf 'amd' ;;
    0x8086) printf 'intel' ;;
    0x10de) printf 'nvidia' ;;
    *) printf '' ;;
  esac
}

cmd_list() {
  local dev card vend vid boot fields=() slot driver pciClass pciId did vid_hex did_hex
  for dev in /sys/class/drm/card[0-9]*/device; do
    [[ -d $dev ]] || continue
    card=${dev%/*}; card=${card##*/}
    [[ $card =~ ^card[0-9]+$ ]] || continue
    [[ -r $dev/vendor ]] || continue
    IFS= read -r vid < "$dev/vendor" || continue
    vid=$(trim "$vid")
    vend=$(vendor_name "$vid")
    [[ -n $vend ]] || continue
    # A card qualifies only when at least one metric is readable.
    case $vend in
      amd)
        [[ -r $dev/gpu_busy_percent || -r $dev/mem_info_vram_used ]] || continue
        ;;
      intel)
        intel_freq_cur_path "$dev" >/dev/null || continue
        ;;
      nvidia)
        resolve_bin nvidia-smi >/dev/null || continue
        ;;
    esac
    boot=0
    if [[ -r $dev/boot_vga ]]; then
      local b
      IFS= read -r b < "$dev/boot_vga" || b=0
      [[ $b == 1 ]] && boot=1
    fi
    slot=""
    if slot=$(uevent_field "$dev/uevent" PCI_SLOT_NAME); then
      [[ $slot =~ ^[0-9a-fA-F:.]+$ ]] || slot=""
    else
      slot=""
    fi
    driver=""
    if driver=$(uevent_field "$dev/uevent" DRIVER); then
      [[ $driver =~ ^[A-Za-z0-9._+-]+$ ]] || driver=""
    else
      driver=""
    fi
    pciClass=""
    if [[ -r $dev/class ]]; then
      IFS= read -r pciClass < "$dev/class" || pciClass=""
      pciClass=$(trim "$pciClass")
      pciClass=${pciClass,,}
    fi
    pciId=""
    did=""
    if [[ -r $dev/device ]]; then
      IFS= read -r did < "$dev/device" || did=""
      did=$(trim "$did")
    fi
    vid_hex=${vid#0x}; vid_hex=${vid_hex#0X}
    did_hex=${did#0x}; did_hex=${did_hex#0X}
    vid_hex=${vid_hex,,}
    did_hex=${did_hex,,}
    if [[ $vid_hex =~ ^[0-9a-f]{4}$ && $did_hex =~ ^[0-9a-f]{4}$ ]]; then
      pciId="$vid_hex:$did_hex"
    fi
    fields+=("$card" "$vend" "$dev" "$boot" "$slot" "$pciClass" "$pciId" "$driver")
  done
  if (( ${#fields[@]} == 0 )); then
    "$JQ" -cn '{ok:true, gpus:[]}'
    return 0
  fi
  # Kernel-controlled card names and paths; grouped through $ARGS.positional
  # so the JSON is built by jq, never by string concatenation.
  "$JQ" -cn --args '
    {ok:true, gpus: [range(0; ($ARGS.positional | length); 8) as $i |
      { card: $ARGS.positional[$i],
        vendor: $ARGS.positional[$i + 1],
        path: $ARGS.positional[$i + 2],
        boot: ($ARGS.positional[$i + 3] == "1"),
        slot: $ARGS.positional[$i + 4],
        pciClass: $ARGS.positional[$i + 5],
        pciId: $ARGS.positional[$i + 6],
        driver: $ARGS.positional[$i + 7] }]}' "${fields[@]}"
}

emit_file() {
  # emit_file <key> <path>: append "key=<content>" to PAYLOAD when readable.
  local key=$1 path=$2 v
  [[ -r $path ]] || return 0
  IFS= read -r v < "$path" 2>/dev/null || return 0
  [[ $v =~ ^[0-9]+$ ]] || return 0
  PAYLOAD+="$key=$v"$'\n'
}

cmd_sample_amd() {
  local dev=$1
  PAYLOAD=""
  emit_file gpu_busy_percent "$dev/gpu_busy_percent"
  emit_file mem_busy_percent "$dev/mem_busy_percent"
  emit_file mem_info_vram_used "$dev/mem_info_vram_used"
  emit_file mem_info_vram_total "$dev/mem_info_vram_total"
  local h
  for h in "$dev"/hwmon/hwmon*; do
    [[ -d $h ]] || continue
    emit_file temp_edge_mc "$h/temp1_input"
    emit_file temp_junction_mc "$h/temp2_input"
    emit_file power1_average_uw "$h/power1_average"
    break
  done
  # Active DPM sclk: the line ending in '*'.
  if [[ -r $dev/pp_dpm_sclk ]]; then
    local line f
    while IFS= read -r line; do
      case $line in
        *'*')
          f=${line%%[Mm][Hh]z*}
          f=${f##*:}
          f=${f//[[:space:]]/}
          [[ $f =~ ^[0-9]+$ ]] && PAYLOAD+="sclk_mhz=$f"$'\n'
          ;;
      esac
      done < "$dev/pp_dpm_sclk" || true
  fi
  local eng_dir name key eng_count=0
  for eng_dir in "$dev"/engine/*; do
    [[ -d $eng_dir ]] || continue
    name=${eng_dir##*/}
    key=${name,,}
    key=${key//./_}
    key=${key//-/_}
    [[ $key =~ ^[a-z0-9_]+$ ]] || continue
    emit_file "eng_$key" "$eng_dir/busy_percent"
    eng_count=$(( eng_count + 1 ))
    (( eng_count >= 32 )) && break
  done
  [[ -n $PAYLOAD ]] || fail "no readable amd metrics under $dev"
  "$JQ" -cn --arg ts "$EPOCHREALTIME" --arg payload "$PAYLOAD" \
    '{ok:true, ts:($ts|tonumber), vendor:"amd", payload:$payload}'
}

cmd_sample_intel() {
  local dev=$1 cur_f max_f
  PAYLOAD=""
  if cur_f=$(intel_freq_cur_path "$dev"); then emit_file gt_cur_freq_mhz "$cur_f"; fi
  if max_f=$(intel_freq_max_path "$dev"); then emit_file gt_max_freq_mhz "$max_f"; fi
  local h
  for h in "$dev"/hwmon/hwmon*; do
    [[ -d $h ]] || continue
    emit_file temp_package_mc "$h/temp1_input"
    break
  done
  [[ -n $PAYLOAD ]] || fail "no readable intel metrics under $dev"
  "$JQ" -cn --arg ts "$EPOCHREALTIME" --arg payload "$PAYLOAD" \
    '{ok:true, ts:($ts|tonumber), vendor:"intel", payload:$payload}'
}

cmd_sample_nvidia() {
  local index=$1
  local SMI TIMEOUT_BIN AWK_BIN payload
  SMI=$(resolve_bin nvidia-smi) || fail "nvidia-smi not found"
  TIMEOUT_BIN=$(resolve_bin timeout) || fail "timeout not found"
  local awk_name=${QUADRANT_AWK:-awk}
  [[ $awk_name =~ ^[A-Za-z0-9._+-]+$ ]] || fail "bad awk name"
  AWK_BIN=$(resolve_bin "$awk_name") || fail "awk not found"
  local -a select=()
  [[ -n $index ]] && select=(-i "$index")
  # Row cap via awk (drains stdin, no SIGPIPE); timeout bounds a hung driver.
  if ! payload=$("$TIMEOUT_BIN" 2 "$SMI" "${select[@]}" \
      --query-gpu=index,name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw,clocks.gr \
      --format=csv,noheader,nounits 2>/dev/null | "$AWK_BIN" 'NR <= 8'); then
    fail "nvidia-smi failed or timed out"
  fi
  [[ -n $payload ]] || fail "nvidia-smi returned no rows"
  "$JQ" -cn --arg ts "$EPOCHREALTIME" --arg payload "$payload" \
    '{ok:true, ts:($ts|tonumber), vendor:"nvidia", payload:$payload}'
}

case ${1:-} in
  list)
    cmd_list
    ;;
  sample)
    vendor=${2:-}
    target=${3:-}
    case $vendor in
      amd|intel)
        [[ -n $target && $target == /sys/class/drm/* && -d $target ]] \
          || fail "bad device path for sample"
        ;;
      nvidia)
        [[ $target =~ ^[0-9]*$ ]] || fail "bad nvidia index"
        ;;
      *) fail "usage: gpu-stats sample amd|intel|nvidia <path|index>" ;;
    esac
    "cmd_sample_$vendor" "$target"
    ;;
  *)
    fail "usage: gpu-stats list | sample <vendor> <target>"
    ;;
esac
