#!/usr/bin/env bash
# system-info — one-shot hardware identity for the Quadrant panel.
#
# Emits one JSON envelope on stdout:
#   {"ok":true,"cpu":{...},"gpus":[...],"lspciPayload":"...","mem":{...},"host":{...}}
#
# Every field is optional (null / empty) when unreadable. Strings travel
# through jq --arg so firmware and PCI-DB text cannot break the transport;
# parsing (including lspci -mm) lives in Model.js. Failures emit
# {"ok":false,"error":...} and exit non-zero.
#
# Usage: system-info
#
# lspci is optional: when pciutils is not installed the payload is empty
# and AMD/Intel cards fall back to vendor + PCI ID in the UI.

# shellcheck disable=SC2016  # jq programs are single-quoted on purpose
set -euo pipefail

fail() {
  local msg=$1 bin=""
  if [[ -x /usr/bin/jq ]]; then bin=/usr/bin/jq
  else bin=$(command -v jq) || bin=""
  fi
  if [[ -n $bin ]]; then
    "$bin" -cn --arg e "$msg" '{ok:false, error:$e}'
  else
    printf '{"ok":false,"error":"helper unavailable"}\n'
  fi
  exit 1
}

# Prefer the distro path so a user-writable PATH entry cannot shadow the
# helper. Fall back to command -v for non-standard prefixes (Nix, etc.).
resolve_bin() {
  local n=$1
  [[ $n =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
  if [[ -x /usr/bin/$n ]]; then
    printf '%s\n' "/usr/bin/$n"
    return 0
  fi
  command -v "$n"
}

JQ=$(resolve_bin jq) || fail "jq not found"

trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

# read_int_file <path> <varname>: integer content, or "" when unreadable.
# shellcheck disable=SC2034  # dst is a nameref; writes land in the caller
read_int_file() {
  local path=$1 v
  local -n dst=$2
  dst=""
  [[ -n $path && -r $path ]] || return 0
  if IFS= read -r v < "$path" 2>/dev/null && [[ $v =~ ^[0-9]+$ ]]; then
    dst=$v
  fi
}

read_line_file() {
  local path=$1
  local -n dst=$2
  dst=""
  [[ -n $path && -r $path ]] || return 0
  IFS= read -r dst < "$path" 2>/dev/null || dst=""
  dst=$(trim "$dst")
}

uevent_field() {
  local path=$1 want=$2 line key val
  [[ -r $path ]] || return 1
  while IFS= read -r line; do
    key=${line%%=*}
    val=${line#*=}
    if [[ $key == "$want" ]]; then
      printf '%s' "$val"
      return 0
    fi
  done < "$path"
  return 1
}

vendor_name() {
  case $1 in
    0x1002|1002) printf 'amd' ;;
    0x8086|8086) printf 'intel' ;;
    0x10de|10de) printf 'nvidia' ;;
    *) printf '' ;;
  esac
}

# --- CPU -------------------------------------------------------------------

modelName="" vendorId="" physCores="" threads="" cacheKb="" mhzNow=""
governor="" maxMhz=""
nproc=0
while IFS= read -r line || [[ -n ${line:-} ]]; do
  case $line in
    processor*)
      nproc=$(( nproc + 1 ))
      ;;
    "model name"*|"Processor"*)
      if [[ -z $modelName ]]; then
        modelName=$(trim "${line#*:}")
      fi
      ;;
    "Hardware"*)
      if [[ -z $modelName ]]; then
        modelName=$(trim "${line#*:}")
      fi
      ;;
    "vendor_id"*)
      if [[ -z $vendorId ]]; then
        vendorId=$(trim "${line#*:}")
      fi
      ;;
    "cpu cores"*)
      if [[ -z $physCores ]]; then
        physCores=$(trim "${line#*:}")
        [[ $physCores =~ ^[0-9]+$ ]] || physCores=""
      fi
      ;;
    "cache size"*)
      if [[ -z $cacheKb ]]; then
        local_cache=$(trim "${line#*:}")
        local_cache=${local_cache%%[^0-9]*}
        [[ $local_cache =~ ^[0-9]+$ ]] && cacheKb=$local_cache
      fi
      ;;
    "cpu MHz"*)
      if [[ -z $mhzNow ]]; then
        mhzNow=$(trim "${line#*:}")
        [[ $mhzNow =~ ^[0-9]+(\.[0-9]+)?$ ]] || mhzNow=""
      fi
      ;;
  esac
done < /proc/cpuinfo

if (( nproc > 0 )); then threads=$nproc; fi
if [[ -z $physCores && -n $threads ]]; then physCores=$threads; fi

read_line_file /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor governor
[[ $governor =~ ^[A-Za-z0-9._+-]+$ ]] || governor=""

max_khz=""
read_int_file /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq max_khz
if [[ -n $max_khz ]]; then
  maxMhz=$(( max_khz / 1000 ))
fi

# Package max is the highest policy, not cpu0 (often an E-core on hybrid).
for pol in /sys/devices/system/cpu/cpufreq/policy[0-9]*; do
  pk=""
  read_int_file "$pol/cpuinfo_max_freq" pk
  if [[ -n $pk ]]; then
    pk_mhz=$(( pk / 1000 ))
    if [[ -z $maxMhz || $pk_mhz -gt $maxMhz ]]; then maxMhz=$pk_mhz; fi
  fi
done

# Unified L3 size from sysfs when present — cpuinfo "cache size" is not
# reliably the package last-level cache.
for idx in /sys/devices/system/cpu/cpu0/cache/index*; do
  [[ -r $idx/level && -r $idx/type && -r $idx/size ]] || continue
  IFS= read -r lv < "$idx/level" || continue
  [[ $lv == 3 ]] || continue
  IFS= read -r typ < "$idx/type" || continue
  [[ $typ == Unified ]] || continue
  IFS= read -r sz < "$idx/size" || continue
  sz=${sz//[[:space:]]/}
  if [[ $sz =~ ^([0-9]+)K$ ]]; then
    cacheKb=${BASH_REMATCH[1]}
  elif [[ $sz =~ ^([0-9]+)M$ ]]; then
    cacheKb=$(( BASH_REMATCH[1] * 1024 ))
  fi
  break
done

expand_cpu_list() {
  local spec=$1 tok a b i
  local -n _ids=$2
  _ids=()
  [[ -n $spec ]] || return 0
  local -a toks=()
  IFS=',' read -r -a toks <<< "$spec"
  for tok in "${toks[@]}"; do
    tok=${tok//[[:space:]]/}
    if [[ $tok =~ ^([0-9]+)-([0-9]+)$ ]]; then
      a=${BASH_REMATCH[1]}; b=${BASH_REMATCH[2]}
      if (( b >= a && b - a < 256 )); then
        for (( i=a; i<=b; i++ )); do _ids+=("$i"); done
      fi
    elif [[ $tok =~ ^[0-9]+$ ]]; then
      _ids+=("$tok")
    fi
  done
}

id_in_list() {
  local want=$1 x
  shift
  for x in "$@"; do
    [[ $x == "$want" ]] && return 0
  done
  return 1
}

cache_shared() {
  local cpu_path=$1 level=$2 idx lv typ shared
  for idx in "$cpu_path"/cache/index*; do
    [[ -r $idx/level && -r $idx/type ]] || continue
    IFS= read -r lv < "$idx/level" || continue
    [[ $lv == "$level" ]] || continue
    IFS= read -r typ < "$idx/type" || continue
    [[ $typ == Unified ]] || continue
    shared=""
    read_line_file "$idx/shared_cpu_list" shared
    printf '%s' "$shared"
    return 0
  done
  printf ''
}

core_cpus_spec="" atom_cpus_spec=""
read_line_file /sys/devices/cpu_core/cpus core_cpus_spec
read_line_file /sys/devices/cpu_atom/cpus atom_cpus_spec
p_ids=() atom_ids=()
expand_cpu_list "$core_cpus_spec" p_ids
expand_cpu_list "$atom_cpus_spec" atom_ids
intel_hybrid=0
(( ${#p_ids[@]} + ${#atom_ids[@]} > 0 )) && intel_hybrid=1

p_l3=()
if (( intel_hybrid )); then
  for id in "${p_ids[@]}"; do
    sh=$(cache_shared "/sys/devices/system/cpu/cpu$id" 3)
    [[ -n $sh ]] && p_l3+=("$sh")
  done
fi

topo_fields=()
topo_count=0
for cpu_dir in /sys/devices/system/cpu/cpu[0-9]*; do
  [[ -d $cpu_dir/topology ]] || continue
  id=${cpu_dir##*/cpu}
  [[ $id =~ ^[0-9]+$ ]] || continue
  if [[ -r $cpu_dir/online ]]; then
    on=""
    IFS= read -r on < "$cpu_dir/online" || on=1
    [[ $on == 1 ]] || continue
  fi
  core=""
  read_int_file "$cpu_dir/topology/core_id" core
  [[ -n $core ]] || core=$id
  l3=$(cache_shared "$cpu_dir" 3)
  maxk=""
  read_int_file "$cpu_dir/cpufreq/cpuinfo_max_freq" maxk
  cap=""
  read_int_file "$cpu_dir/cpu_capacity" cap
  cls=""
  if (( intel_hybrid )); then
    if id_in_list "$id" "${p_ids[@]}"; then
      cls=performance
    elif id_in_list "$id" "${atom_ids[@]}"; then
      cls=efficiency
      if [[ -z $l3 ]]; then
        cls=lowpower
      else
        share_p=0
        for s in "${p_l3[@]}"; do
          if [[ $s == "$l3" ]]; then share_p=1; break; fi
        done
        (( share_p == 0 )) && cls=lowpower
      fi
    fi
  fi
  topo_fields+=("$id" "$core" "$cls" "${maxk:-0}" "${cap:-0}" "$l3")
  topo_count=$(( topo_count + 1 ))
  (( topo_count >= 128 )) && break
done

if (( ${#topo_fields[@]} == 0 )); then
  topo_json='[]'
else
  topo_json=$("$JQ" -cn --args '
    [range(0; ($ARGS.positional | length); 6) as $i |
      { id: ($ARGS.positional[$i] | tonumber),
        core: ($ARGS.positional[$i + 1] | tonumber),
        cls: $ARGS.positional[$i + 2],
        maxKhz: ($ARGS.positional[$i + 3] | tonumber),
        cap: ($ARGS.positional[$i + 4] | tonumber),
        l3: $ARGS.positional[$i + 5] }]' "${topo_fields[@]}")
  threads=$topo_count
  physCores=$("$JQ" -cn --argjson t "$topo_json" '[$t[].core] | unique | length')
fi

# --- GPUs ------------------------------------------------------------------

gpu_fields=()
gpu_count=0
for dev in /sys/class/drm/card[0-9]*/device; do
  [[ -d $dev ]] || continue
  card=${dev%/*}; card=${card##*/}
  [[ $card =~ ^card[0-9]+$ ]] || continue
  [[ -r $dev/vendor ]] || continue
  IFS= read -r vid < "$dev/vendor" || continue
  vid=$(trim "$vid")
  vend=$(vendor_name "$vid")
  [[ -n $vend ]] || continue
  slot=""
  driver=""
  pciId=""
  if slot=$(uevent_field "$dev/uevent" PCI_SLOT_NAME); then
    [[ $slot =~ ^[0-9a-fA-F:.]+$ ]] || slot=""
  else
    slot=""
  fi
  if driver=$(uevent_field "$dev/uevent" DRIVER); then
    [[ $driver =~ ^[A-Za-z0-9._+-]+$ ]] || driver=""
  else
    driver=""
  fi
  did=""
  if [[ -r $dev/device ]]; then
    IFS= read -r did < "$dev/device" || did=""
    did=$(trim "$did")
  fi
  # PCI IDs from sysfs are 0xNNNN; normalize to nnnn:nnnn lowercase.
  vid_hex=${vid#0x}; vid_hex=${vid_hex#0X}
  did_hex=${did#0x}; did_hex=${did_hex#0X}
  vid_hex=${vid_hex,,}
  did_hex=${did_hex,,}
  if [[ $vid_hex =~ ^[0-9a-f]{4}$ && $did_hex =~ ^[0-9a-f]{4}$ ]]; then
    pciId="$vid_hex:$did_hex"
  fi
  gpu_fields+=("$card" "$vend" "$slot" "$driver" "$pciId")
  gpu_count=$(( gpu_count + 1 ))
  (( gpu_count >= 8 )) && break
done

if (( ${#gpu_fields[@]} == 0 )); then
  gpu_json='[]'
else
  gpu_json=$("$JQ" -cn --args '
    [range(0; ($ARGS.positional | length); 5) as $i |
      { card: $ARGS.positional[$i],
        vendor: $ARGS.positional[$i + 1],
        slot: $ARGS.positional[$i + 2],
        driver: $ARGS.positional[$i + 3],
        pciId: $ARGS.positional[$i + 4] }]' "${gpu_fields[@]}")
fi

lspciPayload=""
if LSPCI=$(resolve_bin lspci); then
  lspciPayload=$("$LSPCI" -D -mm 2>/dev/null || true)
  # Cap a runaway dump so one helper run cannot flood QML.
  if (( ${#lspciPayload} > 65536 )); then
    lspciPayload=${lspciPayload:0:65536}
  fi
fi

# --- Memory / swap ---------------------------------------------------------

swap_fields=()
swap_count=0
if [[ -r /proc/swaps ]]; then
  while IFS= read -r line; do
    [[ $line == Filename* ]] && continue
    # Filename can contain spaces (swap files); fields are whitespace-separated
    # with Type/Size/Used/Priority as the last four tokens.
    # shellcheck disable=SC2086
    read -r -a toks <<< "$line"
    (( ${#toks[@]} >= 5 )) || continue
    n=${#toks[@]}
    size=${toks[n-3]}
    type=${toks[n-4]}
    file=${toks[0]}
    if (( n > 5 )); then
      file=""
      for (( i=0; i<n-4; i++ )); do
        [[ -n $file ]] && file+=" "
        file+=${toks[i]}
      done
    fi
    [[ -n $file ]] || continue
    [[ $size =~ ^[0-9]+$ ]] || size=0
    kind=$type
    case $file in
      *zram*) kind="zram" ;;
    esac
    case $kind in
      partition|file|zram) ;;
      *) kind="file" ;;
    esac
    swap_fields+=("$file" "$kind" "$size")
    swap_count=$(( swap_count + 1 ))
    (( swap_count >= 16 )) && break
  done < /proc/swaps
fi

if (( ${#swap_fields[@]} == 0 )); then
  swap_json='[]'
else
  swap_json=$("$JQ" -cn --args '
    [range(0; ($ARGS.positional | length); 3) as $i |
      { file: $ARGS.positional[$i],
        kind: $ARGS.positional[$i + 1],
        sizeKb: ($ARGS.positional[$i + 2] | tonumber) }]' "${swap_fields[@]}")
fi

zram_fields=()
zram_count=0
for z in /sys/block/zram*; do
  [[ -d $z ]] || continue
  dev=${z##*/}
  [[ $dev =~ ^zram[0-9]+$ ]] || continue
  alg=""
  if [[ -r $z/comp_algorithm ]]; then
    IFS= read -r algs < "$z/comp_algorithm" || algs=""
    if [[ $algs =~ \[([A-Za-z0-9_+-]+)\] ]]; then
      alg=${BASH_REMATCH[1]}
    fi
  fi
  disk=""
  read_int_file "$z/disksize" disk
  zram_fields+=("$dev" "$alg" "${disk:-0}")
  zram_count=$(( zram_count + 1 ))
  (( zram_count >= 8 )) && break
done

if (( ${#zram_fields[@]} == 0 )); then
  zram_json='[]'
else
  zram_json=$("$JQ" -cn --args '
    [range(0; ($ARGS.positional | length); 3) as $i |
      { dev: $ARGS.positional[$i],
        alg: $ARGS.positional[$i + 1],
        diskBytes: ($ARGS.positional[$i + 2] | tonumber) }]' "${zram_fields[@]}")
fi

# Unprivileged DIMM type/speed from udev DMI. Never sudo dmidecode.
udevPayload=""
if [[ -r /run/udev/data/+dmi:id ]]; then
  udevPayload=$(< /run/udev/data/+dmi:id) || udevPayload=""
  if (( ${#udevPayload} > 65536 )); then
    udevPayload=${udevPayload:0:65536}
  fi
fi

# --- Host ------------------------------------------------------------------

kernel="" sysVendor="" productName=""
read_line_file /proc/sys/kernel/osrelease kernel
read_line_file /sys/class/dmi/id/sys_vendor sysVendor
read_line_file /sys/class/dmi/id/product_name productName

"$JQ" -n \
  --arg modelName "$modelName" \
  --arg vendorId "$vendorId" \
  --arg physCores "$physCores" \
  --arg threads "$threads" \
  --arg cacheKb "$cacheKb" \
  --arg mhzNow "$mhzNow" \
  --arg governor "$governor" \
  --arg maxMhz "$maxMhz" \
  --argjson topo "$topo_json" \
  --argjson gpus "$gpu_json" \
  --arg lspciPayload "$lspciPayload" \
  --argjson swaps "$swap_json" \
  --argjson zram "$zram_json" \
  --arg udevPayload "$udevPayload" \
  --arg kernel "$kernel" \
  --arg sysVendor "$sysVendor" \
  --arg productName "$productName" \
  '{
    ok: true,
    cpu: {
      modelName: (if $modelName == "" then null else $modelName end),
      vendorId: (if $vendorId == "" then null else $vendorId end),
      physCores: (if $physCores == "" then null else ($physCores|tonumber) end),
      threads: (if $threads == "" then null else ($threads|tonumber) end),
      cacheKb: (if $cacheKb == "" then null else ($cacheKb|tonumber) end),
      mhzNow: (if $mhzNow == "" then null else ($mhzNow|tonumber) end),
      governor: (if $governor == "" then null else $governor end),
      maxMhz: (if $maxMhz == "" then null else ($maxMhz|tonumber) end),
      topo: $topo
    },
    gpus: $gpus,
    lspciPayload: $lspciPayload,
    mem: { swaps: $swaps, zram: $zram, udevPayload: $udevPayload },
    host: {
      kernel: (if $kernel == "" then null else $kernel end),
      sysVendor: (if $sysVendor == "" then null else $sysVendor end),
      productName: (if $productName == "" then null else $productName end)
    }
  }'
