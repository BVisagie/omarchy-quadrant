#!/usr/bin/env python3
"""One-shot DRM fdinfo + idle-residency snapshot for Quadrant.

Prints a single JSON object. Scripts ship counters; Model.js computes busy
percent (per card and per process) from consecutive snapshots. Optional
--slot filters to one PCI device (0000:00:02.0): fdinfo rows by their
drm-pdev, idle residency by the card that sits on that slot. Failures are
ok:false, never a fake 0.

Output shape:
  {"ok":true,"tsNs":..,"slot":"..",
   "engines":[{"pid":123,"client":"0000:00:02.0/7","name":"render","ns":..,
               "cycles":null,"total":null,"capacity":1}, ...],
   "clients":[{"pid":123,"comm":"Hyprland","client":"0000:00:02.0/7","dedicated":..,"shared":..}],
   "rc6":[{"id":"/sys/.../rc6_residency_ms","card":"card1","ms":..}],
   "memDedicated":..,"memShared":..}

A DRM file shared by several processes (fork, inherited fd) carries one
drm-client-id; it is attributed once, to the first pid that reports it.
QUADRANT_PROC_PATH / QUADRANT_SYS_PATH override /proc and /sys for tests.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time


MAX_ENGINE_ROWS = 512
MAX_CLIENT_ROWS = 256


def proc_root() -> str:
    return os.environ.get("QUADRANT_PROC_PATH", "/proc")


def sys_root() -> str:
    return os.environ.get("QUADRANT_SYS_PATH", "/sys")


def parse_size(value: str) -> int | None:
    text = value.strip().lower().replace(",", "")
    if not text:
        return None
    parts = text.split()
    try:
        n = float(parts[0])
    except ValueError:
        digits = "".join(c for c in text if c.isdigit())
        return int(digits) if digits else None
    unit = parts[1] if len(parts) > 1 else ""
    mul = 1
    if unit in ("kib", "ki", "k"):
        mul = 1024
    elif unit in ("mib", "mi", "m"):
        mul = 1024 * 1024
    elif unit in ("gib", "gi", "g"):
        mul = 1024 * 1024 * 1024
    elif unit in ("b", "bytes", ""):
        mul = 1
    return int(n * mul)


def _digits(val: str) -> int | None:
    digits = "".join(c for c in val if c.isdigit())
    return int(digits) if digits else None


def parse_fdinfo(text: str) -> dict | None:
    """Parse one fdinfo file. Returns None when it is not a DRM client."""
    slot = ""
    client = ""
    engines: list[dict] = []
    capacity: dict[str, int] = {}
    dedicated = 0
    shared = 0
    saw_drm = False
    for raw in text.splitlines():
        if ":" not in raw:
            continue
        key, val = raw.split(":", 1)
        key = key.strip()
        val = val.strip()
        if key == "drm-pdev":
            slot = val
            saw_drm = True
        elif key == "drm-client-id":
            client = val
            saw_drm = True
        elif key.startswith("drm-engine-capacity-"):
            name = key[len("drm-engine-capacity-") :]
            n = _digits(val)
            if name and n:
                capacity[name] = n
        elif key.startswith("drm-engine-"):
            name = key[len("drm-engine-") :]
            n = _digits(val)
            if name and n is not None:
                engines.append({"name": name, "ns": n, "cycles": None, "total": None, "capacity": 1})
                saw_drm = True
        elif key.startswith("drm-cycles-"):
            name = key[len("drm-cycles-") :]
            n = _digits(val)
            if name and n is not None:
                engines.append({"name": name, "ns": None, "cycles": n, "total": None, "capacity": 1})
                saw_drm = True
        elif key.startswith("drm-total-cycles-"):
            name = key[len("drm-total-cycles-") :]
            n = _digits(val)
            if name and n is not None:
                for eng in engines:
                    if eng["name"] == name and eng["cycles"] is not None:
                        eng["total"] = n
        elif key.startswith(("drm-resident-vram", "drm-memory-vram", "drm-resident-local")):
            # amdgpu: drm-memory-vram; xe: drm-resident-vram0 / vram1 per region.
            n = parse_size(val)
            if n:
                dedicated += n
                saw_drm = True
        elif key.startswith(("drm-resident-gtt", "drm-memory-gtt", "drm-resident-system")):
            n = parse_size(val)
            if n:
                shared += n
                saw_drm = True
    if not saw_drm:
        return None
    # Capacity lines can precede or follow the engine line they describe.
    for eng in engines:
        cap = capacity.get(eng["name"])
        if cap and cap > 0:
            eng["capacity"] = cap
    return {
        "slot": slot,
        "client": client,
        "engines": engines,
        "dedicated": dedicated,
        "shared": shared,
    }


def read_comm(proc: str, pid: str) -> str:
    try:
        with open(os.path.join(proc, pid, "comm"), "r", errors="ignore") as fh:
            return fh.read(256).strip().replace("\n", " ")[:128]
    except OSError:
        return ""


def snap_fdinfo(want_slot: str) -> dict:
    engines: list[dict] = []
    clients: list[dict] = []
    seen: set[str] = set()
    comms: dict[str, str] = {}
    dedicated = 0
    shared = 0
    proc = proc_root()
    try:
        pids = sorted((p for p in os.listdir(proc) if p.isdigit()), key=int)
    except OSError:
        return {"engines": [], "clients": [], "dedicated": 0, "shared": 0}
    for pid in pids:
        fd_dir = os.path.join(proc, pid, "fd")
        info_dir = os.path.join(proc, pid, "fdinfo")
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd in fds:
            try:
                tgt = os.readlink(os.path.join(fd_dir, fd))
            except OSError:
                continue
            if "/dri/" not in tgt and not tgt.startswith("/dev/dri"):
                continue
            try:
                with open(os.path.join(info_dir, fd), "r", errors="ignore") as fh:
                    parsed = parse_fdinfo(fh.read())
            except OSError:
                continue
            if not parsed:
                continue
            slot = parsed["slot"]
            if want_slot and slot and slot != want_slot:
                continue
            # One DRM client id per open file: a file inherited across fork
            # shows up under every holder but must be counted once.
            if parsed["client"]:
                key = "%s/%s" % (slot, parsed["client"])
            else:
                key = "%s/%s:%s" % (slot, pid, fd)
            if key in seen:
                continue
            seen.add(key)
            pid_n = int(pid)
            dedicated += parsed["dedicated"]
            shared += parsed["shared"]
            if pid not in comms:
                comms[pid] = read_comm(proc, pid)
            if len(clients) < MAX_CLIENT_ROWS:
                clients.append({
                    "pid": pid_n,
                    "comm": comms[pid],
                    "client": key,
                    "dedicated": parsed["dedicated"],
                    "shared": parsed["shared"],
                })
            for eng in parsed["engines"]:
                row = dict(eng)
                row["pid"] = pid_n
                row["client"] = key
                engines.append(row)
            if len(engines) >= MAX_ENGINE_ROWS:
                return {"engines": engines, "clients": clients, "dedicated": dedicated, "shared": shared}
    return {"engines": engines, "clients": clients, "dedicated": dedicated, "shared": shared}


def card_slot(card_dir: str) -> str:
    """PCI slot of a /sys/class/drm/cardN directory, or ""."""
    try:
        with open(os.path.join(card_dir, "device", "uevent"), "r", encoding="utf-8", errors="ignore") as fh:
            for line in fh:
                if line.startswith("PCI_SLOT_NAME="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    try:
        target = os.readlink(os.path.join(card_dir, "device"))
    except OSError:
        return ""
    return os.path.basename(target.rstrip("/"))


def _read_int(path: str) -> int | None:
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return None


def snap_rc6(want_slot: str) -> list[dict]:
    """Idle residency counters (ms) for the selected card.

    i915 exposes rc6_residency_ms; xe exposes gtidle/idle_residency_ms.
    Both grow while the GPU is idle, so Model.js treats them alike. Only
    the card on --slot is reported, so a hybrid machine's iGPU can never
    stand in for a discrete card's idle time.
    """
    out: list[dict] = []
    root = os.path.join(sys_root(), "class", "drm")
    try:
        cards = sorted(c for c in os.listdir(root) if c.startswith("card") and "-" not in c)
    except OSError:
        return out
    seen: set[str] = set()
    for card in cards:
        card_dir = os.path.join(root, card)
        if want_slot:
            if card_slot(card_dir) != want_slot:
                continue
        candidates = [
            os.path.join(card_dir, "gt", "gt0", "rc6_residency_ms"),
            os.path.join(card_dir, "gt", "gt1", "rc6_residency_ms"),
            os.path.join(card_dir, "gt", "rc6_residency_ms"),
            os.path.join(card_dir, "device", "drm", card, "gt", "gt0", "rc6_residency_ms"),
            os.path.join(card_dir, "gt", "gt0", "gtidle", "idle_residency_ms"),
            os.path.join(card_dir, "gt", "gt1", "gtidle", "idle_residency_ms"),
        ]
        for tile in ("tile0", "tile1"):
            for gt in ("gt0", "gt1"):
                candidates.append(os.path.join(card_dir, "device", tile, gt, "gtidle", "idle_residency_ms"))
        for path in candidates:
            if path in seen or not os.path.isfile(path):
                continue
            seen.add(path)
            if path.endswith("rc6_residency_ms"):
                enable = path.replace("rc6_residency_ms", "rc6_enable")
                if os.path.isfile(enable) and (_read_int(enable) or 0) == 0:
                    continue
            ms = _read_int(path)
            if ms is None:
                continue
            out.append({"id": path, "card": card, "ms": ms})
    return out


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--slot", default="")
    args, _ = parser.parse_known_args()
    slot = args.slot.strip()
    if slot and not all(c.isalnum() or c in ":." for c in slot):
        json.dump({"ok": False, "error": "bad slot"}, sys.stdout, separators=(",", ":"))
        print()
        return 1
    snap = snap_fdinfo(slot)
    payload = {
        "ok": True,
        "tsNs": time.monotonic_ns(),
        "slot": slot,
        "engines": snap["engines"][:MAX_ENGINE_ROWS],
        "clients": snap["clients"][:MAX_CLIENT_ROWS],
        "rc6": snap_rc6(slot),
        "memDedicated": snap["dedicated"],
        "memShared": snap["shared"],
    }
    json.dump(payload, sys.stdout, separators=(",", ":"))
    print()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:  # noqa: BLE001 — helper must never crash the widget
        json.dump({"ok": False, "error": str(exc)[:120]}, sys.stdout, separators=(",", ":"))
        print()
        raise SystemExit(1)
