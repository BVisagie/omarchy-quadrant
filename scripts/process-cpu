#!/usr/bin/env bash
# process-cpu — one-shot top-by-CPU process sampler for the Quadrant panel.
#
# Emits one JSON envelope on stdout:
#   {"ok":true,"ts":<epoch>,"metric":"pcpu","payload":"<raw ps output>"}
# The raw ps text travels as a single JSON string built with jq --arg, so a
# hostile process name can never break the transport. Parsing happens in
# Model.js (node-tested). On any failure the envelope is {"ok":false,...}
# and the exit code is non-zero — a failure must never look like "no
# activity" to the caller.
#
# Usage: process-cpu [row_count]     row_count clamps to 1..10 (default 5)
#
# CPU% is an interval over consecutive helper runs (state in
# XDG_RUNTIME_DIR), not procps lifetime %CPU. The first sample after a
# cold start is empty. QUADRANT_PROC_PATH overrides /proc for tests.

# shellcheck disable=SC2016  # jq programs are single-quoted on purpose
set -euo pipefail

fail() {
  local msg=$1 bin=""
  if [[ -x /usr/bin/jq ]]; then bin=/usr/bin/jq
  else bin=$(command -v jq) || bin=""
  fi
  if [[ -n $bin ]]; then
    "$bin" -cn --arg e "$msg" '{ok:false, error:$e}'
  else
    printf '{"ok":false,"error":"helper unavailable"}\n'
  fi
  exit 1
}

# Prefer the distro path so a user-writable PATH entry cannot shadow the
# helper. Fall back to command -v for non-standard prefixes (Nix, etc.).
resolve_bin() {
  local n=$1
  [[ $n =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
  if [[ -x /usr/bin/$n ]]; then
    printf '%s\n' "/usr/bin/$n"
    return 0
  fi
  command -v "$n"
}

JQ=$(resolve_bin jq) || fail "jq not found"
PY=$(resolve_bin python3) || fail "python3 not found"

count=${1:-5}
[[ $count =~ ^[0-9]+$ ]] || fail "bad row count '$count'"
(( count < 1 )) && count=1
(( count > 10 )) && count=10

# Interval CPU% from /proc/<pid>/stat utime+stime over the widget's poll
# window (state in XDG_RUNTIME_DIR). Payload is a JSON array of
# {pid,value,comm,exe,cmd}; Model.js names wrappers and collapses duplicates.
# comm comes from /proc/<pid>/comm, never argv. exe is the basename of the
# exe symlink; cmd is a clipped cmdline used only as a whitelist hint.
export QUADRANT_PCPU_COUNT=$count
if ! payload=$("$PY" - <<'PY'
import json, os, time

count = max(1, min(10, int(os.environ.get("QUADRANT_PCPU_COUNT", "5"))))
proc = os.environ.get("QUADRANT_PROC_PATH", "/proc")
runtime = os.environ.get("XDG_RUNTIME_DIR") or os.path.join(os.path.expanduser("~"), ".cache")
state_path = os.path.join(runtime, "quadrant-pcpu.json")
clk = os.sysconf("SC_CLK_TCK") or 100
now = time.monotonic()
limit = min(32, max(count * 4, 16))

def parse_stat(text):
    rparen = text.rfind(")")
    if rparen < 0:
        return None
    fields = text[rparen + 1 :].split()
    if len(fields) < 13:
        return None
    try:
        return int(fields[11]) + int(fields[12])
    except ValueError:
        return None

def exe_base(pid):
    try:
        target = os.readlink(os.path.join(proc, pid, "exe"))
    except OSError:
        return ""
    return os.path.basename(target).replace(" (deleted)", "")[:64]

def cmdline_hint(pid):
    try:
        raw = open(os.path.join(proc, pid, "cmdline"), "rb").read().replace(b"\0", b" ")
        return raw.decode("utf-8", "replace").strip()[:160]
    except OSError:
        return ""

snap = {}
try:
    pids = os.listdir(proc)
except OSError:
    pids = []
for pid in pids:
    if not pid.isdigit():
        continue
    try:
        with open(os.path.join(proc, pid, "stat"), "r", errors="ignore") as fh:
            ticks = parse_stat(fh.read())
        if ticks is None:
            continue
        with open(os.path.join(proc, pid, "comm"), "r", errors="ignore") as fh:
            comm = fh.read().strip().replace("\n", " ")[:128] or pid
    except OSError:
        continue
    snap[pid] = {"ticks": ticks, "comm": comm, "exe": exe_base(pid), "cmd": cmdline_hint(pid)}

prev = None
try:
    with open(state_path, "r", encoding="utf-8") as fh:
        prev = json.load(fh)
except (OSError, ValueError):
    prev = None

tmp = state_path + ".tmp"
try:
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump({"t": now, "p": {k: {"ticks": v["ticks"]} for k, v in snap.items()}}, fh, separators=(",", ":"))
    os.replace(tmp, state_path)
except OSError:
    try:
        os.unlink(tmp)
    except OSError:
        pass

rows = []
if isinstance(prev, dict) and "t" in prev and "p" in prev:
    dt = now - float(prev["t"])
    before = prev.get("p") or {}
    if 0.4 <= dt <= 15:
        for pid, cur in snap.items():
            old = before.get(pid)
            if not old:
                continue
            delta = cur["ticks"] - int(old.get("ticks") or cur["ticks"])
            if delta < 0:
                continue
            pct = 100.0 * delta / float(clk) / dt
            rows.append((pct, int(pid), cur))

rows.sort(key=lambda r: (-r[0], r[1]))
out = []
for pct, pid, rec in rows[:limit]:
    out.append({
        "pid": pid,
        "value": round(pct, 1),
        "comm": rec["comm"],
        "exe": rec["exe"],
        "cmd": rec["cmd"],
    })
print(json.dumps(out, separators=(",", ":")))
PY
); then
  fail "process sampler failed"
fi

"$JQ" -cn --arg ts "$EPOCHREALTIME" --arg payload "$payload" \
  '{ok:true, ts:($ts|tonumber), metric:"pcpu", payload:$payload}'
