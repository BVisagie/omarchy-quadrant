#!/usr/bin/env bash
# process-memory — one-shot top-by-RSS process sampler for the Quadrant panel.
#
# Emits one JSON envelope on stdout:
#   {"ok":true,"ts":<epoch>,"metric":"rssKb","payload":"<json array>"}
# rss is KiB from /proc/<pid>/statm; the "% of RAM" column is computed in
# QML from the stream's MemTotal. Failures emit {"ok":false,...} and exit
# non-zero.
#
# Usage: process-memory [row_count]     row_count clamps to 1..10 (default 5)
#
# Payload is JSON so Model.js can name wrappers and collapse duplicate apps.

# shellcheck disable=SC2016  # jq programs are single-quoted on purpose
set -euo pipefail

fail() {
  local msg=$1 bin=""
  if [[ -x /usr/bin/jq ]]; then bin=/usr/bin/jq
  else bin=$(command -v jq) || bin=""
  fi
  if [[ -n $bin ]]; then
    "$bin" -cn --arg e "$msg" '{ok:false, error:$e}'
  else
    printf '{"ok":false,"error":"helper unavailable"}\n'
  fi
  exit 1
}

# Prefer the distro path so a user-writable PATH entry cannot shadow the
# helper. Fall back to command -v for non-standard prefixes (Nix, etc.).
resolve_bin() {
  local n=$1
  [[ $n =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
  if [[ -x /usr/bin/$n ]]; then
    printf '%s\n' "/usr/bin/$n"
    return 0
  fi
  command -v "$n"
}

JQ=$(resolve_bin jq) || fail "jq not found"
PY=$(resolve_bin python3) || fail "python3 not found"

count=${1:-5}
[[ $count =~ ^[0-9]+$ ]] || fail "bad row count '$count'"
(( count < 1 )) && count=1
(( count > 10 )) && count=10

# RSS from /proc/<pid>/statm (resident pages). Payload is a JSON array of
# {pid,value,comm,exe,cmd} so Model.js can name wrappers and collapse
# duplicate apps. comm is /proc/<pid>/comm, never argv.
export QUADRANT_PRSS_COUNT=$count
if ! payload=$("$PY" - <<'PY'
import json, os

count = max(1, min(10, int(os.environ.get("QUADRANT_PRSS_COUNT", "5"))))
proc = os.environ.get("QUADRANT_PROC_PATH", "/proc")
page = os.sysconf("SC_PAGE_SIZE") or 4096
limit = min(32, max(count * 4, 16))

def exe_base(pid):
    try:
        target = os.readlink(os.path.join(proc, pid, "exe"))
    except OSError:
        return ""
    return os.path.basename(target).replace(" (deleted)", "")[:64]

def cmdline_hint(pid):
    try:
        raw = open(os.path.join(proc, pid, "cmdline"), "rb").read().replace(b"\0", b" ")
        return raw.decode("utf-8", "replace").strip()[:160]
    except OSError:
        return ""

rows = []
try:
    pids = os.listdir(proc)
except OSError:
    pids = []
for pid in pids:
    if not pid.isdigit():
        continue
    try:
        with open(os.path.join(proc, pid, "statm"), "r", encoding="utf-8") as fh:
            fields = fh.read().split()
        if len(fields) < 2:
            continue
        rss_kb = int(fields[1]) * page / 1024.0
        with open(os.path.join(proc, pid, "comm"), "r", errors="ignore") as fh:
            comm = fh.read().strip().replace("\n", " ")[:128] or pid
    except (OSError, ValueError):
        continue
    rows.append((rss_kb, int(pid), comm, exe_base(pid), cmdline_hint(pid)))

rows.sort(key=lambda r: (-r[0], r[1]))
out = []
for rss_kb, pid, comm, exe, cmd in rows[:limit]:
    out.append({
        "pid": pid,
        "value": round(rss_kb),
        "comm": comm,
        "exe": exe,
        "cmd": cmd,
    })
print(json.dumps(out, separators=(",", ":")))
PY
); then
  fail "process sampler failed"
fi

"$JQ" -cn --arg ts "$EPOCHREALTIME" --arg payload "$payload" \
  '{ok:true, ts:($ts|tonumber), metric:"rssKb", payload:$payload}'
